# Copy this file to .env for local development (never commit .env).

DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string

# Database: SQLite (db.sqlite3) when empty. Any PostgreSQL URL works, e.g.
# Supabase (session pooler, port 5432) or Neon:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Where photos are stored: local | db | s3 (see README)
MEDIA_STORAGE=local

# E-mail (booking notifications, invitations, password reset).
# Without it, e-mails are printed in the console.
# EMAIL_URL=smtp+tls://USER:PASSWORD@smtp-relay.brevo.com:587
# DEFAULT_FROM_EMAIL=Campings Suite <reservas@your-domain.com>

# Name of the product shown in the panel (and in the optional "Powered by"
# credit of the camping websites) and where that credit links to.
# PLATFORM_NAME=Campings Suite
# PLATFORM_CREDIT_URL=https://www.your-company.com

# Optional: every camping gets https://<slug>.<CAMPING_DOMAIN_SUFFIX> as its
# address until its own domain is connected. Needs a wildcard DNS record and
# certificate (see README). Locally, "localhost:8000" works in most browsers:
# http://los-pinos-demo.localhost:8000/
# CAMPING_DOMAIN_SUFFIX=campings.your-company.com

# Campings are created by the platform administrators (one sale per camping).
# Enable this only if campings should be able to create their own account.
# SIGNUP_ENABLED=False
# SIGNUP_REQUIRES_APPROVAL=True
