# Copy this file to .env for local development (never commit .env).

DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string

# Database: SQLite (db.sqlite3) when empty. Any PostgreSQL URL works, e.g.
# Supabase (session pooler, port 5432) or Neon:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Where photos are stored: local | db | s3 (see README)
MEDIA_STORAGE=local

# E-mail (booking notifications, invitations, password reset).
# Without it, e-mails are printed in the console.
# EMAIL_URL=smtp+tls://USER:PASSWORD@smtp-relay.brevo.com:587
# DEFAULT_FROM_EMAIL=Campings Suite <reservas@your-domain.com>

# PLATFORM_NAME=Campings Suite
# SIGNUP_ENABLED=True
# SIGNUP_REQUIRES_APPROVAL=True
